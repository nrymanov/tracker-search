<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TrackerSearch.Dialogs.Import"
             mc:Ignorable="d" 
             MinWidth="600" MinHeight="450"
             x:Class="TrackerSearch.Dialogs.Import.ProgressView"
             x:DataType="vm:ProgressViewModel"
             >

  <Grid RowDefinitions="Auto, *, Auto">
    <!--Header-->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
            Padding="15"
            >
      <TextBlock Classes="wizard-page-title"
                 HorizontalAlignment="Center"
                 Text="Импорт документов"
                 />
    </Border>

    <!--Content-->
    <Grid Grid.Row="1"
          RowDefinitions="Auto, *"
          RowSpacing="5"
          Margin="40"
          >

      <Grid Grid.Row="0" Margin="10" ColumnDefinitions="Auto, *">
        <Svg Width="60" Path="/Assets/import_small.svg"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Spacing="10"
                    Margin="10, 0"
                    >
          <ProgressBar IsIndeterminate="True"/>

          <TextBlock Text="{Binding Message, FallbackValue='Выполняется импорт документов. Пожалуйста подождите...'}"/>
        </StackPanel>
      </Grid>

      <ListBox Grid.Row="1" 
               BorderThickness="1"
               BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
               >
      </ListBox>

    </Grid>

    <!--Buttons-->
    <Border Grid.Row="2"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}"
            Padding="5"
            >
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="5"
                  Classes="dlg-footer">
        <Button Content="Отмена"
                IsDefault="True" IsCancel="True"
                Command="{Binding CancelCommand}"
                />
      </StackPanel>
    </Border>
  </Grid>

</UserControl>
