<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TrackerOfflineSearch.Avalonia.Views.EmptyIndexView"
             x:CompileBindings="False">
    <Border Margin="40" Padding="40" CornerRadius="12">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <TextBlock Text="🔍 Документы отсутствуют" 
                       FontSize="20" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Загрузите архив XML.XZ с документами, чтобы начать работу."
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>
            <Button Content="📂 Загрузить архив" 
                    Width="180"
                    Command="{Binding LoadArchiveCommand}"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
