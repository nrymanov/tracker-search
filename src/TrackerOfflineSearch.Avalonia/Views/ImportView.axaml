<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TrackerOfflineSearch.Avalonia.Views.ImportView"
             x:CompileBindings="False">
    <StackPanel Margin="40" Spacing="16" VerticalAlignment="Center">
        <TextBlock Text="📦 Импорт документов" FontSize="22" FontWeight="Bold" />

        <TextBlock Text="{Binding Stage, FallbackValue='Stage WTF'}" FontSize="16" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="20" 
                     IsIndeterminate="True"/>
        <TextBlock Text="{Binding Progress, StringFormat='Завершено: {0:F0}%', FallbackValue=Загружено 0 документов}"
                   Foreground="Gray" />

        <Border Margin="10" Padding="12" Background="#202020" CornerRadius="8">
            <TextBlock Text="{Binding Tip, FallbackValue=some tips}" Foreground="#C0C0C0" FontStyle="Italic"/>
        </Border>

        <TextBlock Text="Пожалуйста, подождите — это может занять несколько минут."
                   Foreground="Gray" FontSize="13" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
