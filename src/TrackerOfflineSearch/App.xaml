<prism:PrismApplication 
    x:Class="TrackerOfflineSearch.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TrackerOfflineSearch"
    xmlns:prism="http://prismlibrary.com/"
    
    xmlns:System="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="B2VConverter"/>

        <System:Double x:Key="StandardButtonWidth">75</System:Double>
        <System:Double x:Key="StandardButtonHeight">25</System:Double>

        <Thickness x:Key="StandardMargin">5</Thickness>
        <Thickness x:Key="StandardMarginTRB">0, 5, 5, 5</Thickness>

        <Style x:Key="StandardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource StandardButtonWidth}"/>
            <Setter Property="Height" Value="{DynamicResource StandardButtonHeight}"/>
            <Setter Property="Margin" Value="{DynamicResource StandardMargin}"/>
        </Style>
        
        <!--Wizard-->
        <GridLength x:Key="WizardSectionSeparatorHeight">25</GridLength>
    </Application.Resources>
</prism:PrismApplication>
