<UserControl x:Class="TrackerOfflineSearch.Views.QueryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrackerOfflineSearch.Views" 
             xmlns:vm="clr-namespace:TrackerOfflineSearch.ViewModels" 
             d:DataContext="{d:DesignInstance Type=vm:QueryEditorViewModel}"
             mc:Ignorable="d" d:DesignHeight="168" d:DesignWidth="365">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="{x:Type RowDefinition}" x:Key="AdvancedRowStyle">
            <Setter Property="Height" Value="0" />
            <!--TODO set to 0-->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAdvancedQuery}" Value="True">
                    <Setter Property="Height" Value="Auto" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid ShowGridLines="False" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValueColumn"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValueColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Style="{StaticResource AdvancedRowStyle}"/>
            <RowDefinition Style="{StaticResource AdvancedRowStyle}"/>
            <RowDefinition Style="{StaticResource AdvancedRowStyle}"/>
            <RowDefinition Style="{StaticResource AdvancedRowStyle}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Column="0" Grid.Row="0" Margin="3" 
                   VerticalAlignment="Center" HorizontalAlignment="Right" 
                   Text="Title"/>
        <TextBox Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="5" Margin="3"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" 
                     Text="{Binding TitleFilter, UpdateSourceTrigger=PropertyChanged}"
                     />

        <!-- Content -->
        <TextBlock Grid.Column="0" Grid.Row="1" Margin="3" 
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="Content"/>
        <TextBox Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="5" Margin="3"
                     TextWrapping="Wrap"  
                     VerticalAlignment="Center"
                     Text="{Binding ContentFilter, UpdateSourceTrigger=PropertyChanged}"
                     />

        <!-- Forum -->
        <TextBlock Grid.Column="0" Grid.Row="2" Margin="3" 
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="Forum"/>
        <ComboBox Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="5" Margin="3"
                      ItemsSource="{Binding Forums}" SelectedItem="{Binding ForumFilter}"
                      />

        <!-- Size -->
        <TextBlock Grid.Column="0" Grid.Row="3" Margin="3"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="Size"/>
        <TextBlock Grid.Column="1" Grid.Row="3" Margin="3"
                   VerticalAlignment="Center"
                   Text="from" />
        <TextBox Grid.Column="2" Grid.Row="3" Margin="3"
                 VerticalAlignment="Center"
                 Text="{Binding FromSizeFilter, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Column="3" Grid.Row="3" Margin="3"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="to"/>
        <TextBox Grid.Column="4" Grid.Row="3" Margin="3"
                 VerticalAlignment="Center"
                 Text="{Binding ToSizeFilter, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Created -->
        <TextBlock Grid.Column="0" Grid.Row="4"  Margin="3"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="Created"/>
        <ComboBox Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="5" Margin="3" 
                  ItemsSource="{Binding Intervals, Mode=OneWay}" 
                  DisplayMemberPath="Title" 
                  SelectedItem="{Binding SelectedInterval}"
                  />

        <!-- Show simple/advanced search form -->
        <TextBlock Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="6" Margin="3" HorizontalAlignment="Right">
                <Hyperlink Command="{Binding ChangeQueryTypeCommand, Mode=OneWay}">
                    <Run>
                        <Run.Style>
                            <Style>
                                <Setter Property="Run.Text" Value="Advanced search" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvancedQuery}" Value="True">
                                        <Setter Property="Run.Text" Value="Simple search" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>                    
                    </Run>
                </Hyperlink>
        </TextBlock>

    </Grid>
</UserControl>
