<UserControl x:Class="TrackerOfflineSearch.ViewModels.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrackerOfflineSearch.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="5">
            <Hyperlink>Import</Hyperlink>
        </TextBlock>
        
        <TextBlock Grid.Row="1" Margin="5, 0, 5, 5">
            <Hyperlink>Optimize</Hyperlink>
        </TextBlock>
    </Grid>
</UserControl>
