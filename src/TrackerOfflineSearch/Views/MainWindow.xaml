<Window x:Class="TrackerOfflineSearch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:TrackerOfflineSearch.Views" 
        xmlns:vm="clr-namespace:TrackerOfflineSearch.ViewModels" 
        xmlns:helpers="clr-namespace:TrackerOfflineSearch.Helpers" 
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"        
        Title="{Binding Title}" 
        d:DesignHeight="450" d:DesignWidth="800" 
        WindowStartupLocation="Manual"
        >
    <Window.Resources>
        <Style x:Key="GridSplitterPreviewStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Fill="#80000000"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridSplitterStyle1" TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Canvas RenderOptions.EdgeMode="Aliased" Background="red"
                                    UseLayoutRounding="True"
                                    Height="50" VerticalAlignment="Center"
                                    Width="5" HorizontalAlignment="Center">
                                <Line X1="0" X2="0" Y1="0" Y2="50" Stroke="White" StrokeThickness="1"/>
                                <Line X1="1" X2="1" Y1="0" Y2="50" Stroke="#A0A0A0" StrokeThickness="1"/>

                                <Line X1="2" X2="2" Y1="0" Y2="50" Stroke="White" StrokeThickness="1"/>
                                <Line X1="3" X2="3" Y1="0" Y2="50" Stroke="#A0A0A0" StrokeThickness="1"/>

                                <Line X1="4" X2="4" Y1="0" Y2="50" Stroke="White" StrokeThickness="1"/>
                                <Line X1="5" X2="5" Y1="0" Y2="50" Stroke="#A0A0A0" StrokeThickness="1"/>
                            </Canvas>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Column 0 -->
        <GroupBox Grid.Column="0" Grid.Row="0"
                  Margin="5"
                  Header="Search" 
                  prism:RegionManager.RegionName="{x:Static local:RegionNames.SearchFormRegion}"
                  />

        <ContentControl Grid.Column="0" Grid.Row="1" 
                        Margin="5, 0, 5, 5"
                        prism:RegionManager.RegionName="{x:Static local:RegionNames.SearchResultRegion}"
                        />

        <GroupBox Grid.Column="0" Grid.Row="2" Grid.RowSpan="2"
                  Margin="5, 0, 5, 5"
                  Header="Database"
                  prism:RegionManager.RegionName="{x:Static local:RegionNames.DatabaseToolsRegion}"/>
        
        <!-- Column 1 -->
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                      Style="{DynamicResource GridSplitterStyle1}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                      Width="9" 
                      ShowsPreview="True"/>

        <!-- Column 2 -->
        <GroupBox Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" 
                  Margin="5"
                  Header="Post"
                  prism:RegionManager.RegionName="{x:Static local:RegionNames.PostInfoViewRegion}"/>
    </Grid>
</Window>
