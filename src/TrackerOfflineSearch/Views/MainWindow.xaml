<Window x:Class="TrackerOfflineSearch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:TrackerOfflineSearch.Views"
        xmlns:vm="clr-namespace:TrackerOfflineSearch.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        Height="450" 
        Width="800">
       
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ContentControl Grid.Column="0" Grid.Row="0" Margin="5"
                        prism:RegionManager.RegionName="{x:Static local:RegionNames.SearchFormRegion}"
                        />

        <ContentControl Grid.Column="0" Grid.Row="1" Margin="5, 0, 5, 5"
                        prism:RegionManager.RegionName="{x:Static local:RegionNames.SearchResultRegion}"
                        />

        <ContentControl Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="0, 5, 5, 5"
                        prism:RegionManager.RegionName="{x:Static local:RegionNames.SearchToolsRegion}"
                        />
    </Grid>
</Window>
