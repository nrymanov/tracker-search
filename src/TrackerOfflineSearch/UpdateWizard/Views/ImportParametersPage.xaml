<UserControl x:Class="TrackerOfflineSearch.UpdateWizard.Views.ImportParametersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TrackerOfflineSearch.UpdateWizard.Views"
             xmlns:vm="clr-namespace:TrackerOfflineSearch.UpdateWizard.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ImportParametersPageViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="350"
             d:DesignWidth="600"
             >
    <Grid Margin="{DynamicResource StandardMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{DynamicResource WizardSectionSeparatorHeight}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{DynamicResource WizardSectionSeparatorHeight}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                   Text="{Binding Title, FallbackValue=Welcom to Import Wizard!}" 
                   Margin="{DynamicResource StandardMargin}" 
                   FontSize="20" 
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                   Margin="{DynamicResource StandardMargin}"
                   Text="Tracker archive:"/>

        <TextBox Grid.Column="0" Grid.Row="3"
                 Margin="{DynamicResource StandardMargin}"
                 IsReadOnly="True" Text="{Binding ArchivePath}" />
        <Button Grid.Column="1" Grid.Row="3"
                Margin="{DynamicResource StandardMarginTRB}"
                Content="Blowse" 
                Style="{DynamicResource StandardButtonStyle}" Command="{Binding SelectArchiveCommand, Mode=OneWay}"/>

        <CheckBox x:Name="cbOptimize" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2"
                  Margin="{DynamicResource StandardMargin}"
                  Content="Optimize database after import completed" IsChecked="{Binding Optimize}"/>

        <Border Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2"
                Margin="{DynamicResource StandardMargin}" 
                Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" 
                CornerRadius="5" 
                BorderThickness="1" Visibility="{Binding IsChecked, Converter={StaticResource B2VConverter}, ElementName=cbOptimize}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">

            <TextBlock Margin="{DynamicResource StandardMargin}" 
                       TextWrapping="Wrap"
                       LineHeight="15" 
                       >
                <Bold>Note: </Bold>
                <Run Text="This is a horribly costly operation!" FontWeight="SemiBold"/><LineBreak/>
                This requires free space that is proportional to the size of the index.
                For example, if your index size is 10 MB then you need an additional 30 MB free for this to complete.
                In general, once this completes, the total size of the index will be less than the size of the starting index. It could be quite a bit smaller (if there were many pending deletes) or just slightly smaller.
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
